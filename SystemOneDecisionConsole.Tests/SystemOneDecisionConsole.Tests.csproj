<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <RunSettingsFilePath>$(MSBuildProjectDirectory)/Test.runsettings</RunSettingsFilePath>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="MSTest" Version="4.0.2" />
    <ProjectReference Include="../SystemOneDecisionsConsole/SystemOneDecisionsConsole.csproj" />
    <Using Include="Microsoft.VisualStudio.TestTools.UnitTesting" />
  </ItemGroup>
  <Target Name="CopyConsoleTestApplication" AfterTargets="Build">
    <MSBuild Projects="../SystemOneDecisionsConsole/SystemOneDecisionsConsole.csproj"
             Targets="GetTargetPath" Properties="Configuration=$(Configuration);TargetFramework=net10.0">
      <Output TaskParameter="TargetOutputs" ItemName="_ConsoleTargetPath" />
    </MSBuild>
    <PropertyGroup>
      <_ConsoleOutputDirectory>@(_ConsoleTargetPath->'%(RootDir)%(Directory)')</_ConsoleOutputDirectory>
    </PropertyGroup>
    <Error Condition="'$(_ConsoleOutputDirectory)' == ''" Text="The referenced console project's output directory could not be resolved." />
    <ItemGroup>
      <_ConsoleRuntimeFiles Include="$(_ConsoleOutputDirectory)**/*" />
    </ItemGroup>
    <Copy SourceFiles="@(_ConsoleRuntimeFiles)"
          DestinationFiles="@(_ConsoleRuntimeFiles->'$(TargetDir)TestApp/%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />
  </Target>
</Project>
